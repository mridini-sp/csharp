@model List<ShoppingCartApp.Models.Product>

<h2>Shopping Cart</h2>

<a asp-action="Cart" class="btn btn-success">View Cart</a>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Product</th>
        <th>Price</th>
        <th>Action</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>₹@p.Price</td>
            <td>
                <a asp-action="AddToCart" asp-route-id="@p.Id"
                   class="btn btn-primary">Add</a>
            </td>
        </tr>
    }
</table>